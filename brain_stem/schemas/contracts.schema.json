{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic Brain Substrate Phase 1 Contracts",
  "description": "Serialized in-process intent contract for the CPU-only routing prototype.",
  "$ref": "#/$defs/intentEnvelope",
  "$defs": {
    "scopeVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "user_id", "project_id", "workspace_id"],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "user_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "workspace_id": { "type": "string", "minLength": 1 }
      }
    },
    "intentEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "transaction_id",
        "correlation_id",
        "action",
        "goal",
        "scope"
      ],
      "properties": {
        "protocol_version": { "const": "1.0" },
        "transaction_id": { "type": "string", "minLength": 1 },
        "correlation_id": { "type": "string", "minLength": 1 },
        "action": { "const": "ROUTE_TASK" },
        "goal": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scopeVector" }
      }
    }
  }
}